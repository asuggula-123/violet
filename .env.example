# Copy to .env and fill in: `npm run dev`, `npm start` and the CLIs read ./.env (a variable already set in the
# environment wins). .env is git-ignored. Never commit real values.

# development | test | production
NODE_ENV=development
# HTTP port for the server.
PORT=8080
# Postgres connection string. Leave empty to use embedded PGlite at ./.data/pglite.
DATABASE_URL=
# Public https base URL of this server (webhooks, OAuth redirects).
PUBLIC_BASE_URL=
# Bearer token for the dev endpoints /dev/inbound and /dev/outbox (fake transport, not production; off while unset).
ADMIN_TOKEN=
# Claude API key for the Brain. Unset: no model is called; owner free text gets a fixed "model isn't connected" reply.
ANTHROPIC_API_KEY=
# Model for the Brain (the owner's assistant). Defaults to claude-opus-5-5.
VIOLET_MODEL=
# Model for the Envoy, the mind that talks to other owners' agents (same household only: give both owners
# the same --household in owner:add). Agent-to-agent messages stay on this server; only the Envoy's model calls
# (and free/busy reads, with Google) go out. Defaults to VIOLET_MODEL.
VIOLET_ENVOY_MODEL=
# on | off. Empty = on: when the model declines a request, the API may answer it with a fallback model it
# picks (the brain.turn / a2a.envoy_turn rows show the model that answered). off: no fallback, ever.
VIOLET_MODEL_FALLBACK=
# fake | telegram
TRANSPORT=fake
# Comma-separated Telegram bot tokens ("<bot id>:<secret>"), one per agent. The bot id is the agent address.
TELEGRAM_BOT_TOKENS=
# Secret token Telegram sends with each webhook call: 16-256 chars of A-Z a-z 0-9 _ -. Required in webhook mode.
TELEGRAM_WEBHOOK_SECRET=
# webhook | polling (polling: local development without a public URL)
TELEGRAM_MODE=webhook
# Google is used only when the next four are all set. Otherwise, in production, calendar and Gmail requests fail
# ("Google isn't connected on this server"; approved events are not booked); elsewhere in-memory stand-ins are used.
# Google OAuth client ID (Cloud Console, type Web application).
GOOGLE_CLIENT_ID=
# Google OAuth client secret of that client.
GOOGLE_CLIENT_SECRET=
# OAuth redirect URI registered for that client: <PUBLIC_BASE_URL>/oauth/google/callback.
GOOGLE_REDIRECT_URI=
# 32 random bytes, base64. Encrypts Google refresh tokens at rest.
TOKEN_ENC_KEY=
# Space-separated Google OAuth scopes. Empty = defaults: calendar.freebusy, calendar.events.owned,
# gmail.readonly, gmail.drafts.create (all under https://www.googleapis.com/auth/).
# gmail.drafts.create can create drafts but not send. If Google's consent screen rejects it, use
# https://www.googleapis.com/auth/gmail.compose instead: the HTTP allow-list still makes sending impossible.
GOOGLE_SCOPES=

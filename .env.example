# Copy to .env and fill in. Never commit real values.

# development | test | production
NODE_ENV=development
# HTTP port for the server.
PORT=8080
# Postgres connection string. Leave empty to use embedded PGlite at ./.data/pglite.
DATABASE_URL=
# Public https base URL of this server (webhooks, OAuth redirects).
PUBLIC_BASE_URL=
# Bearer token for admin and dev endpoints (dev endpoints are off while unset). Generate a long random string.
ADMIN_TOKEN=
# Claude API key (milestone 2+).
ANTHROPIC_API_KEY=
# Model for the Brain. Defaults to claude-opus-5-5.
VIOLET_MODEL=
# Model for the Envoy. Defaults to VIOLET_MODEL.
VIOLET_ENVOY_MODEL=
# fake | telegram
TRANSPORT=fake
# Comma-separated Telegram bot tokens ("<bot id>:<secret>"), one per agent. The bot id is the agent address.
TELEGRAM_BOT_TOKENS=
# Secret token Telegram sends with each webhook call: 16-256 chars of A-Z a-z 0-9 _ -. Required in webhook mode.
TELEGRAM_WEBHOOK_SECRET=
# webhook | polling (polling: local development without a public URL)
TELEGRAM_MODE=webhook
# Google OAuth client (milestone 3).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# 32 random bytes, base64. Encrypts Google refresh tokens at rest.
TOKEN_ENC_KEY=
# Space-separated Google OAuth scopes. Empty = defaults: calendar.freebusy, calendar.events.owned,
# gmail.readonly, gmail.drafts.create (all under https://www.googleapis.com/auth/).
# gmail.drafts.create can create drafts but not send. If Google's consent screen rejects it, use
# https://www.googleapis.com/auth/gmail.compose instead: the HTTP allow-list still makes sending impossible.
GOOGLE_SCOPES=

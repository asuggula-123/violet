{
  "name": "violet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pg": "node -e \"if(!process.env.TEST_DATABASE_URL){console.error('TEST_DATABASE_URL is required');process.exit(1)}\" && vitest run",
    "migrate": "tsx src/cli/migrate.ts",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "owner:add": "tsx src/cli/ownerAdd.ts",
    "google:link": "tsx src/cli/googleLink.ts",
    "migrate:prod": "node dist/cli/migrate.js",
    "owner:add:prod": "node dist/cli/ownerAdd.js",
    "google:link:prod": "node dist/cli/googleLink.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@electric-sql/pglite": "^0.5.16",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
